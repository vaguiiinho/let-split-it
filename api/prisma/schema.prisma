generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id              String        @id
  username        String        @unique
  passwordHash    String
  role            UserRole      @default(USER)
  personId        String        @unique
  isDemo          Boolean       @default(false)
  createdAt       DateTime
  createdPeople   Person[]      @relation("PersonCreatedBy")
  person          Person        @relation("PersonUser", fields: [personId], references: [id], onDelete: Restrict)
  ownedGroups     Group[]
  invitesSent     GroupInvite[] @relation("InviteInviter")
  invitesReceived GroupInvite[] @relation("InviteInvitee")
}

model GroupInvite {
  id          String       @id
  groupId     String
  inviterId   String
  inviteeId   String
  status      InviteStatus @default(PENDING)
  createdAt   DateTime
  respondedAt DateTime?
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter     User         @relation("InviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee     User         @relation("InviteInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviteeId, status])
  @@index([groupId, status])
}

model Person {
  id               String               @id
  name             String
  nameKey          String               @unique
  pixKey           String?
  createdAt        DateTime
  memberships      GroupMember[]
  paid             Expense[]
  shares           ExpenseParticipant[]
  paymentsSent     Payment[]            @relation("PaymentFrom")
  paymentsReceived Payment[]            @relation("PaymentTo")
  user             User?                @relation("PersonUser")
  createdById      String?
  createdBy        User?                @relation("PersonCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model Group {
  id        String        @id
  name      String
  createdAt DateTime
  ownerId   String?
  owner     User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  members   GroupMember[]
  expenses  Expense[]
  payments  Payment[]
  invites   GroupInvite[]

  @@index([ownerId])
}

model GroupMember {
  groupId  String
  personId String
  position Int
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@id([groupId, personId])
  @@index([personId])
}

model Expense {
  id           String               @id
  groupId      String
  description  String
  amountCents  Int
  payerId      String
  createdAt    DateTime
  position     Int
  group        Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer        Person               @relation(fields: [payerId], references: [id], onDelete: Restrict)
  participants ExpenseParticipant[]

  @@index([groupId])
}

model ExpenseParticipant {
  expenseId String
  memberId  String
  weight    Int
  position  Int
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member    Person  @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@id([expenseId, memberId])
}

model Payment {
  id          String   @id
  groupId     String
  fromId      String
  toId        String
  amountCents Int
  createdAt   DateTime
  position    Int
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from        Person   @relation("PaymentFrom", fields: [fromId], references: [id], onDelete: Restrict)
  to          Person   @relation("PaymentTo", fields: [toId], references: [id], onDelete: Restrict)

  @@index([groupId])
}
