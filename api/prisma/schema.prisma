generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Person {
  id               String               @id
  name             String
  nameKey          String               @unique
  pixKey           String?
  createdAt        DateTime
  memberships      GroupMember[]
  paid             Expense[]
  shares           ExpenseParticipant[]
  paymentsSent     Payment[]            @relation("PaymentFrom")
  paymentsReceived Payment[]            @relation("PaymentTo")
}

model Group {
  id        String        @id
  name      String
  createdAt DateTime
  members   GroupMember[]
  expenses  Expense[]
  payments  Payment[]
}

model GroupMember {
  groupId  String
  personId String
  position Int
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@id([groupId, personId])
  @@index([personId])
}

model Expense {
  id           String               @id
  groupId      String
  description  String
  amountCents  Int
  payerId      String
  createdAt    DateTime
  position     Int
  group        Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer        Person               @relation(fields: [payerId], references: [id], onDelete: Restrict)
  participants ExpenseParticipant[]

  @@index([groupId])
}

model ExpenseParticipant {
  expenseId String
  memberId  String
  weight    Int
  position  Int
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member    Person  @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@id([expenseId, memberId])
}

model Payment {
  id          String   @id
  groupId     String
  fromId      String
  toId        String
  amountCents Int
  createdAt   DateTime
  position    Int
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from        Person   @relation("PaymentFrom", fields: [fromId], references: [id], onDelete: Restrict)
  to          Person   @relation("PaymentTo", fields: [toId], references: [id], onDelete: Restrict)

  @@index([groupId])
}
