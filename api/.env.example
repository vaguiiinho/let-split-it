# Postgres do docker-compose.yml (raiz). Deve bater com POSTGRES_* do .env da raiz.
DATABASE_URL="postgresql://racha:racha@localhost:5432/racha_ai?schema=public"
# Banco isolado usado por `npm run test:e2e` (criado automaticamente pelo prisma db push).
DATABASE_URL_TEST="postgresql://racha:racha@localhost:5432/racha_ai_test?schema=public"
PORT=3333

# Segredo do JWT (HS256). OBRIGATÓRIO em produção, mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Senha do usuário "admin" criado pelo seed. Troque em produção (mínimo 8 caracteres).
ADMIN_PASSWORD=admin123
# Limpeza periódica dos dados de demonstração (horas; vazio ou 0 desliga).
DEMO_PURGE_INTERVAL_HOURS=
